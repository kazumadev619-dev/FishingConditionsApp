# ============================================
# 環境変数テンプレート
# このファイルを .env.local にコピーして値を設定
# ============================================

# Database
# アプリ実行時の接続（本番は Neon の pooled エンドポイント）
DATABASE_URL=postgresql://FishingPostgres:FishingPostgres@localhost:5432/fishing_app
# Prisma CLI（migrate/seed）用の接続（本番は Neon の direct エンドポイント）
# ローカルでは DATABASE_URL と同じ値でよい
DATABASE_URL_DIRECT=postgresql://FishingPostgres:FishingPostgres@localhost:5432/fishing_app

# Redis
REDIS_URL=redis://localhost:6379

# Auth
AUTH_SECRET=your_auth_secret_here
AUTH_URL=http://localhost:3000

# Google OAuth
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret

# ============================================
# External APIs（外部APIキー）
# ============================================

# [必須] OpenWeatherMap API
# 天気データ（気温、湿度、気圧、風速など）の取得に必要
# 取得方法: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key

# [必須] Google Maps API
# 取得方法: https://console.cloud.google.com/
#
# キーは用途ごとに2本に分ける（#143）。1本で兼ねることはできない:
# ブラウザからのリクエストには Referer が付き、サーバーからは付かないため、
# リファラ制限を掛けた瞬間にサーバー側の Geocoding が REQUEST_DENIED で落ちる。
#
# [ブラウザ用] Maps JavaScript API のみ / HTTP リファラ制限あり。
# NEXT_PUBLIC_ 接頭辞によりビルド時にバンドルへ埋め込まれる（＝公開される前提）。
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_browser_google_maps_api_key
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your_google_maps_map_id

# [サーバー用] Geocoding API のみ。位置情報のフリー検索で使う。
# NEXT_PUBLIC_ を付けてはいけない。付けるとバンドルに焼き込まれ、
# 分割した意味が無くなる。本番では k8s Secret からランタイムに渡る。
GOOGLE_MAPS_API_KEY=your_server_google_maps_api_key

# ============================================
# Docker (開発環境用)
# ============================================

POSTGRES_USER=FishingPostgres
POSTGRES_PASSWORD=FishingPostgres
POSTGRES_DB=fishing_app
POSTGRES_PORT=5432
REDIS_PORT=6379
REDISINSIGHT_PORT=8001
APP_PORT=3000

# ============================================
# Email Service (Resend)
# ============================================

# [必須] Resend API Key
# メール検証リンク送信に必要
RESEND_API_KEY=re_xxxxxxxxxxxxx

# [必須] 送信元メールアドレス
# Resendで検証済みドメインを使用
EMAIL_FROM=onboarding@resend.dev

# [必須] Next.js URL
# メール内のリンク生成に使用
NEXTAUTH_URL=http://localhost:3000

# ============================================
# Logging
# ============================================

# [オプション] ログレベル設定
# production: warn (警告以上のみ)
# development: debug (すべて)
# 未設定の場合は NODE_ENV に応じて自動設定
LOG_LEVEL=debug

