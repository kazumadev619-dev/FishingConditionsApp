{
  "env": {
    "MAX_THINKING_TOKENS": "10000"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.agents/hooks/post_edit_check.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.agents/hooks/linter_config_guard.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.agents/hooks/secret_guard.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
