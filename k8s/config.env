# 非機密の環境変数。Deployment が envFrom で丸ごと読み込む。
#
# kustomization.yaml の configMapGenerator が ConfigMap を生成する。生成名には
# 内容のハッシュが付き、Deployment の configMapRef ごと書き換わるため、ここを
# 変えると Pod が必ず入れ替わる。固定名の ConfigMap を resources に置くと、
# 環境変数は Pod 起動時にしか読まれないので apply しても無反映になる（#133）。
#
# 機密の値は k8s/secret.enc.yaml（SOPS 暗号化）。混ぜないこと。

NODE_ENV=production
LOG_LEVEL=info

# Auth.js
#
# ⚠️ AUTH_URL は消してはいけない。TLS は Cloudflare で終端しており Pod には
# 平文 HTTP で届くため、Auth.js は「HTTPS かどうか」を AUTH_URL のスキームだけで
# 判断している。ここが消える / http:// になると、セッション Cookie から
# __Host- プレフィックスと Secure 属性が静かに外れる（エラーは出ない）。#134
AUTH_URL=https://fishing.kazuma-lab.com
NEXTAUTH_URL=https://fishing.kazuma-lab.com

# AUTH_URL があれば trustHost は true になるが、AUTH_URL を消したときに
# 認証が静かに全滅するのを防ぐ保険として明示する。
# 注: この変数は存在チェックのみで、"false" を入れても有効化される。
AUTH_TRUST_HOST=true

# Redis（論理 DB 0 / prefix fc: が Next.js の割り当て。Go は DB 1 / api:）
REDIS_URL=redis://redis.fishing.svc.cluster.local:6379/0
