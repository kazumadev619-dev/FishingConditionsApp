{
  "name": "fishing-conditions-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "biome format --write ./src",
    "format:check": "biome format ./src",
    "lint:fast": "oxlint src/",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint-and-format": "npm run lint:fix && npm run format",
    "check-code": "npm run lint && npm run format:check && npm run type-check && npm run test",
    "full-check": "npm run lint-and-format && npm run check-code",
    "prisma:generate": "dotenv -e .env.local -- prisma generate",
    "prisma:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "prisma:seed": "dotenv -e .env.local -- node --import tsx/esm prisma/seed.ts",
    "prisma:studio": "dotenv -e .env.local -- prisma studio",
    "prisma:reset": "dotenv -e .env.local -- prisma migrate reset",
    "update-port-coords": "dotenv -e .env.local -- node --import tsx/esm scripts/update-port-coordinates.ts",
    "update-port-coords:dry-run": "dotenv -e .env.local -- node --import tsx/esm scripts/update-port-coordinates.ts --dry-run",
    "docker:restart": "cd docker && docker compose restart app",
    "docker:dev": "cd docker && docker compose --env-file ../.env.local up -d",
    "docker:dev:build": "cd docker && docker compose --env-file ../.env.local up -d --build",
    "docker:logs": "cd docker && docker compose logs -f app",
    "docker:down": "cd docker && docker compose down",
    "docker:down:volumes": "cd docker && docker compose down -v"
  },
  "prisma": {
    "seed": "node --import tsx/esm prisma/seed.ts"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "oxlint",
      "biome check --write --no-errors-on-unmatched"
    ],
    "src/**/*.{json,md}": [
      "biome format --write"
    ]
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-email/components": "^1.0.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@types/bcrypt": "^6.0.0",
    "@types/ioredis": "^4.28.10",
    "@vis.gl/react-google-maps": "^1.9.0",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.43.0",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.553.0",
    "next": "^16.3.1",
    "next-auth": "^5.0.0-beta.30",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.20.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@commitlint/cli": "^20.5.3",
    "@next/eslint-plugin-next": "^16.3.1",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "commitlint-config-gitmoji": "^2.3.1",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxlint": "^1.78.0",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.26",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.1.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^5.0.0"
  }
}
