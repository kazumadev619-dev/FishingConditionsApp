generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// 認証・ユーザー系
// ============================================

/// ユーザー情報（認証+プロフィール統合）
model users {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique @db.VarChar(255)
  password_hash     String?   @db.VarChar(255)
  name              String?   @db.VarChar(100)
  avatar_url        String?   @db.VarChar(500)
  is_sso_user       Boolean   @default(false)
  email_verified_at DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  // リレーション
  identities      identities[]
  favorites       user_favorites[]
  search_history  user_search_history[]
  settings        user_settings?
}

/// OAuth認証プロバイダー情報（Google等）
model identities {
  id              String    @id @default(uuid()) @db.Uuid
  user_id         String    @db.Uuid
  provider        String    @db.VarChar(50)
  provider_id     String    @db.VarChar(255)
  identity_data   Json?
  last_sign_in_at DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  // リレーション
  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_id])
  @@index([user_id])
}

/// メール検証トークン（アカウント連携時の検証用）
model verification_tokens {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @db.VarChar(255)
  token      String   @unique @db.VarChar(255)
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([email])
  @@index([expires_at])
}

// ============================================
// 釣り場・位置情報系
// ============================================

/// 釣り場マスタ
model locations {
  id            String        @id @default(uuid()) @db.Uuid
  name          String        @db.VarChar(200)
  latitude      Float
  longitude     Float
  region        String?       @db.VarChar(100)
  prefecture    String?       @db.VarChar(50)
  location_type location_type @default(OTHER)
  port_id       String?       @db.Uuid
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  updated_at    DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  // リレーション
  port           ports?                @relation(fields: [port_id], references: [id])
  weather_cache  weather_cache[]
  favorites      user_favorites[]
  search_history user_search_history[]

  @@index([latitude, longitude])
  @@index([prefecture])
}

/// 港マスタ（潮汐API用）
model ports {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(100)
  prefecture_code String   @db.VarChar(10)
  prefecture_name String?  @db.VarChar(50)
  port_code       String   @db.VarChar(10)
  latitude        Float?
  longitude       Float?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  // リレーション
  locations  locations[]
  tide_cache tide_cache[]

  @@unique([prefecture_code, port_code])
  @@index([prefecture_code])
}

/// 釣り場タイプ
enum location_type {
  SHORE      // 岸釣り（堤防・磯）
  SURF       // サーフ（砂浜）
  PORT       // 港・漁港
  RIVER      // 河川・河口
  LAKE       // 湖・池
  OFFSHORE   // オフショア（船釣り）
  OTHER      // その他
}

// ============================================
// 環境データ・キャッシュ系
// ============================================

/// 天気データキャッシュ（TTL: 30分）
model weather_cache {
  id          String   @id @default(uuid()) @db.Uuid
  location_id String   @db.Uuid
  data        Json
  fetched_at  DateTime @default(now()) @db.Timestamptz(6)
  expires_at  DateTime @db.Timestamptz(6)

  // リレーション
  location locations @relation(fields: [location_id], references: [id], onDelete: Cascade)

  @@index([location_id])
  @@index([expires_at])
}

/// 潮汐データキャッシュ（TTL: 6時間）
model tide_cache {
  id         String   @id @default(uuid()) @db.Uuid
  port_id    String   @db.Uuid
  date       DateTime @db.Date
  data       Json
  fetched_at DateTime @default(now()) @db.Timestamptz(6)
  expires_at DateTime @db.Timestamptz(6)

  // リレーション
  port ports @relation(fields: [port_id], references: [id], onDelete: Cascade)

  @@unique([port_id, date])
  @@index([expires_at])
}

// ============================================
// ユーザーアクション系
// ============================================

/// お気に入り釣り場
model user_favorites {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  location_id String   @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  // リレーション
  user     users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  location locations @relation(fields: [location_id], references: [id], onDelete: Cascade)

  @@unique([user_id, location_id])
  @@index([user_id])
}

/// 検索履歴
model user_search_history {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  location_id String   @db.Uuid
  searched_at DateTime @default(now()) @db.Timestamptz(6)

  // リレーション
  user     users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  location locations @relation(fields: [location_id], references: [id], onDelete: Cascade)

  @@index([user_id, searched_at(sort: Desc)])
  @@index([location_id])
}

/// ユーザー設定
model user_settings {
  id                    String   @id @default(uuid()) @db.Uuid
  user_id               String   @unique @db.Uuid
  default_location_id   String?  @db.Uuid
  notification_enabled  Boolean  @default(true)
  theme                 String   @default("system") @db.VarChar(20)
  unit_system           String   @default("metric") @db.VarChar(20)
  preferences           Json?
  updated_at            DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  // リレーション
  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
}
